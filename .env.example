LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Gate de acesso (Basic Auth) — obrigatorio em producao, ja que a app usa
# chaves reais e pagas. Se ausentes, a app fica sem protecao (ok so em localhost).
APP_USER=chefcaseiro
APP_PASSWORD=troque-por-uma-senha-forte

# v3 "Musa Balance" — canal Telegram (ver README/CLAUDE.md pra passo a passo
# de criacao do bot via BotFather). TELEGRAM_WEBHOOK_SECRET e' o valor que
# voce escolhe e passa em secret_token no setWebhook — sem ele, o endpoint
# fica sem verificacao extra (nao recomendado em producao).
TELEGRAM_BOT_TOKEN=123456:abc-token-do-botfather
TELEGRAM_WEBHOOK_SECRET=escolha-uma-string-aleatoria
